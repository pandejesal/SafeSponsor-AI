# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DODO_PAYMENTS_API_KEY: Secret key for Dodo Payments API (test or live mode).
DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_MODE: "test_mode" or "live" (default: test_mode).
DODO_PAYMENTS_MODE=test_mode
# DODO_PAYMENTS_WEBHOOK_SECRET: Secret key for verifying Dodo Payments webhook signatures.
DODO_PAYMENTS_WEBHOOK_SECRET=
# DODO_PAYMENTS_PRODUCT_ID_SINGLE: Optional Dodo Payments product ID for Single Report ($8).
DODO_PAYMENTS_PRODUCT_ID_SINGLE=
# DODO_PAYMENTS_PRODUCT_ID_CHANNEL: Optional Dodo Payments product ID for Channel Report ($19).
DODO_PAYMENTS_PRODUCT_ID_CHANNEL=
# DODO_PAYMENTS_PRODUCT_ID_SUBSCRIPTION: Optional Dodo Payments product ID for Unlimited Subscription ($149/mo).
DODO_PAYMENTS_PRODUCT_ID_SUBSCRIPTION=
# DODO_PAYMENTS_DISCOUNT_CODE_PRO_INTRO: Dodo discount code for the first-purchase Pro intro ($99).
# Create a fixed $50-off discount in the Dodo dashboard and put its code here. The checkout route
# pre-applies it once per user (webhook stamps introProClaimed after the first grant); leave unset to disable.
DODO_PAYMENTS_DISCOUNT_CODE_PRO_INTRO=

# YOUTUBE_API_KEY: Optional key for fetching YouTube video comments via YouTube Data API v3.
YOUTUBE_API_KEY=

# GROQ_API_KEY: Backup AI provider key used if Gemini API is down or unavailable.
GROQ_API_KEY=

# NEXT_PUBLIC_RECAPTCHA_SITE_KEY: reCAPTCHA Enterprise site key for Firebase App Check client initialization.
# PRODUCTION REALITY: set to 6LeSBYEtAAAAAGni_ZwCSYlA2qVYqUPAKawr4rC8 (the live production site key).
# Leave empty only in environments where client App Check tokens are intentionally disabled.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeSBYEtAAAAAGni_ZwCSYlA2qVYqUPAKawr4rC8

# ENFORCE_APP_CHECK: OPT-IN enforcement of Firebase App Check on API routes.
# COUPLING WARNING: enforcement is safe ONLY when the client reliably mints valid tokens - i.e.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY is set AND reCAPTCHA is not blocked by ad blockers/privacy
# extensions on the user's browser. If enforcement is on and the client cannot mint tokens, legitimate signed-in users get locked out of the API (401).
ENFORCE_APP_CHECK=false
# Semantics: "true" = reject requests WITHOUT a valid App Check token; empty/"false" = verify the
# header if present but never reject its absence. A token that IS present but invalid is ALWAYS
# rejected, regardless of this flag.

# PRO_DAILY_AUDIT_CAP: max audits per day per Unlimited Pro subscription user.
# Counts ALL audits — paid users skip the global cache by design, so there is no cache exemption.
PRO_DAILY_AUDIT_CAP=50

# COST_ALERT_THRESHOLD_USD: per-audit cost alert threshold in USD (sum of estCostUsd
# across all LLM calls in one audit). Weekly alert threshold is computed as
# 75% of (cap × 7 days × $0.10) — i.e. $26.25/week at the default cap of 50.
COST_ALERT_THRESHOLD_USD=0.30

# --- M5: cross-platform evidence providers (all OPTIONAL; providers degrade gracefully) ---

# TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET: official Twitch Helix API app credentials.
# Without them the Twitch provider returns metadata-unavailable (data_quality: limited).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# SAFESPONSOR_ENABLE_IG_SCRAPE: HARD-GATED Instagram scrape tier. DO NOT enable until
# the legal/compliance review is signed off (scraping IG against ToS is a legal risk).
# Default: metadata-only via public oEmbed + web-search-grounded backlash scan.
SAFESPONSOR_ENABLE_IG_SCRAPE=false

# SAFESPONSOR_ENABLE_TIKTOK_SCRAPE: TikTok scraper tier (HTML metadata extraction).
# Off by default; oEmbed metadata tier runs regardless.
SAFESPONSOR_ENABLE_TIKTOK_SCRAPE=false

# APIFY_API_TOKEN / APIFY_ACTOR_ID: optional Apify free-tier rotation for TikTok.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=

# DEV ONLY: NEXT_PUBLIC_RECAPTCHA_SITE_KEY is only exercised in production-like builds.
# In dev, FIREBASE_APPCHECK_DEBUG_TOKEN=true is set automatically and mints debug tokens that
# MUST be registered in the Firebase console (App Check > Apps) or analyze/checkout return 401.
