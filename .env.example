# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DODO_PAYMENTS_API_KEY: Secret key for Dodo Payments API (test or live mode).
DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_MODE: "test_mode" or "live" (default: test_mode).
DODO_PAYMENTS_MODE=test_mode
# DODO_PAYMENTS_WEBHOOK_SECRET: Secret key for verifying Dodo Payments webhook signatures.
DODO_PAYMENTS_WEBHOOK_SECRET=
# DODO_PAYMENTS_PRODUCT_ID_SINGLE: Optional Dodo Payments product ID for Single Report ($10).
DODO_PAYMENTS_PRODUCT_ID_SINGLE=
# DODO_PAYMENTS_PRODUCT_ID_CHANNEL: Optional Dodo Payments product ID for Channel Report ($25).
DODO_PAYMENTS_PRODUCT_ID_CHANNEL=
# DODO_PAYMENTS_PRODUCT_ID_SUBSCRIPTION: Optional Dodo Payments product ID for Unlimited Subscription ($199/mo).
DODO_PAYMENTS_PRODUCT_ID_SUBSCRIPTION=

# YOUTUBE_API_KEY: Optional key for fetching YouTube video comments via YouTube Data API v3.
YOUTUBE_API_KEY=

# GROQ_API_KEY: Backup AI provider key used if Gemini API is down or unavailable.
GROQ_API_KEY=

# NEXT_PUBLIC_RECAPTCHA_SITE_KEY: reCAPTCHA v3 / Enterprise site key for Firebase App Check client initialization.
# LEAVE EMPTY: App Check is opted out (no billing) — the app and API routes degrade gracefully.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ENFORCE_APP_CHECK: Set to "false" in production (App Check is opted out).
# When "true", API routes reject requests without a valid App Check token.
ENFORCE_APP_CHECK=false
